rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    // 有料版: plans/{uid}.until（期限の日時）が今より先なら有効
    function isPro(uid) {
      let path = /databases/$(database)/documents/plans/$(uid);
      return exists(path) && get(path).data.until is timestamp && get(path).data.until > request.time;
    }

    // ツリー（1ツリー = 1ドキュメント）。members に入っているメールアドレスの人だけが読み書きできる
    //   owner / ownerEmail … 作った人（変更不可）
    //   members           … 共有メンバーのメールアドレス（小文字）。担当者の候補にもなる
    //   names / uids      … メンバーの表示名と UID（各自が自分の分だけ書ける。UID は本人のものだけ）
    // 有料版の制限:
    //   - 招待（メンバーの追加）はだれでもできる
    //   - 共有中（メンバー2人以上）のツリーの中身（json・name）を変えられるのは、有料版が有効なユーザーだけ。
    //     無料版の人は閲覧のみ（抜ける・自分の名前の変更・オーナーによるメンバーの追加や解除はできる）
    //   - 自分1人のツリーは無料版でも編集できる
    match /trees/{treeId} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function isOwner() { return request.auth.uid == before().owner; }
      function changed() { return after().diff(before()).affectedKeys(); }
      function ownKeyOnly(field) {
        return after().get(field, {}).diff(before().get(field, {})).affectedKeys().hasOnly([me()]);
      }
      function namesOk() {
        return !changed().hasAny(['names']) || isOwner() || ownKeyOnly('names');
      }
      function uidsOk() {
        return !changed().hasAny(['uids'])
          || (ownKeyOnly('uids') && after().uids[me()] == request.auth.uid);
      }
      function membersOk() {
        return after().members == before().members
          // オーナー: 自由に増やしたり外したりできる（自分は外せない）
          || (isOwner() && before().ownerEmail in after().members)
          // メンバー: 自分だけを外す（抜ける）
          || (!isOwner() && after().members.toSet() == before().members.toSet().difference([me()].toSet()));
      }
      function contentOk() {
        return !changed().hasAny(['json', 'updatedAt', 'name'])
          || before().members.size() <= 1
          || isPro(request.auth.uid);
      }

      allow get: if signedIn() && (resource == null || me() in resource.data.members);
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && after().owner == request.auth.uid
        && after().ownerEmail == me()
        && after().members == [me()];
      allow update: if signedIn()
        && me() in before().members
        && after().owner == before().owner
        && after().ownerEmail == before().ownerEmail
        && after().members is list
        && after().members.size() <= 100
        && membersOk()
        && namesOk()
        && uidsOk()
        && contentOk();
      allow delete: if signedIn() && isOwner();
    }

    // 有料版の状態。書き込みはサーバー（管理者・決済の仕組み）だけ。読むのはログインしている人なら可
    // （共有画面のメンバー一覧に、各メンバーが有料版＝編集できるかを出すため）
    match /plans/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 各ユーザーの設定（自分のツリーの ID・最後に開いたツリー）と、以前の保存場所（users/{uid}/trees/main）
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
