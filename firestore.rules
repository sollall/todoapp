rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    // 有料版: plans/{uid}.until（期限の日時）が今より先なら有効
    function isPro(uid) {
      let path = /databases/$(database)/documents/plans/$(uid);
      return exists(path) && get(path).data.until is timestamp && get(path).data.until > request.time;
    }

    // ツリー（1ツリー = 1ドキュメント）。members に入っているメールアドレスの人だけが読み書きできる
    //   owner / ownerEmail … 作った人（変更不可）
    //   members           … 共有メンバーのメールアドレス（小文字）。担当者の候補にもなる
    //   names             … メンバーの表示名（各自が自分の分だけ書ける）
    // 有料版の制限:
    //   - メンバーを増やせる（招待できる）のは、有料版が有効なオーナーだけ。作るときは自分1人だけ
    //   - オーナーの有料版が切れると、オーナー以外のメンバーは閲覧のみ（抜ける・自分の名前の変更はできる）
    //   - メンバーを外す・自分のツリーを編集する・端末間で同期するのは無料でもできる
    match /trees/{treeId} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function isOwner() { return request.auth.uid == before().owner; }
      function changed() { return after().diff(before()).affectedKeys(); }
      function added() { return after().members.toSet().difference(before().members.toSet()); }
      function namesOk() {
        return !changed().hasAny(['names'])
          || isOwner()
          || after().get('names', {}).diff(before().get('names', {})).affectedKeys().hasOnly([me()]);
      }
      function membersOk() {
        return after().members == before().members
          // オーナー: 外すのは自由。増やすのは有料版のときだけ。自分は外せない
          || (isOwner() && before().ownerEmail in after().members && (added().size() == 0 || isPro(request.auth.uid)))
          // メンバー: 自分だけを外す（抜ける）
          || (!isOwner() && after().members.toSet() == before().members.toSet().difference([me()].toSet()));
      }

      allow get: if signedIn() && (resource == null || me() in resource.data.members);
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && after().owner == request.auth.uid
        && after().ownerEmail == me()
        && after().members == [me()];
      allow update: if signedIn()
        && me() in before().members
        && after().owner == before().owner
        && after().ownerEmail == before().ownerEmail
        && after().members is list
        && after().members.size() <= 100
        && membersOk()
        && namesOk()
        && (isOwner() || !changed().hasAny(['json', 'updatedAt', 'name']) || isPro(before().owner));
      allow delete: if signedIn() && isOwner();
    }

    // 有料版の状態。書き込みはサーバー（管理者・決済の仕組み）だけ。読むのはログインしている人なら可
    // （共有ツリーのメンバーが、オーナーの有料版が有効か＝編集できるかを画面に出すため）
    match /plans/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 各ユーザーの設定（自分のツリーの ID・最後に開いたツリー）と、以前の保存場所（users/{uid}/trees/main）
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
