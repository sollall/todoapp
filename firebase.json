{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "my_app/dist",
    "predeploy": [
      "npm --prefix my_app ci",
      "npm --prefix my_app run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  }
}
