{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "my_app/dist",
    "predeploy": ["npm --prefix my_app ci", "npm --prefix my_app run build"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
